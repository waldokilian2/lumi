# rev C USB-CDC LCD panel — allow non-root serial access (all known PIDs)
#
# The device changes identity when it wakes:
#   ASLEEP : 1a86:ca21  WCH CDC-ACM  ("UsbMonitor", serial CT21INCH)
#   AWAKE  : 1d6b:0121  Linux Foundation CDC gadget ("Android", serial 20080411)
#            1d6b:0106  (alt awake PID)
#            0525:a4a7  (older awake revision)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="ca21", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d6b", ATTRS{idProduct}=="0121", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d6b", ATTRS{idProduct}=="0106", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0525", ATTRS{idProduct}=="a4a7", MODE="0666"

# Allow the same non-root app to reset only these known panels after a stalled
# USB transfer. Access to unrelated USB devices is unchanged.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1d6b", ATTR{idProduct}=="0121", MODE="0666"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1d6b", ATTR{idProduct}=="0106", MODE="0666"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0525", ATTR{idProduct}=="a4a7", MODE="0666"
